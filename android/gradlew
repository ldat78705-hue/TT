#!/bin/sh

##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
##############################################################################

# Attempt to set APP_HOME
PRG="$0"
APP_HOME=$(cd "$(dirname "$PRG")" && pwd -P)

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine Java command
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

# Check wrapper jar exists
if [ ! -f "$CLASSPATH" ]; then
    echo "ERROR: gradle-wrapper.jar not found at $CLASSPATH"
    echo "Attempting to download..."
    mkdir -p "$APP_HOME/gradle/wrapper"
    
    # Download Gradle distribution and extract wrapper
    GRADLE_URL="https://services.gradle.org/distributions/gradle-8.2-bin.zip"
    TEMP_DIR=$(mktemp -d)
    
    if command -v curl > /dev/null 2>&1; then
        curl -sL "$GRADLE_URL" -o "$TEMP_DIR/gradle.zip"
    elif command -v wget > /dev/null 2>&1; then
        wget -q "$GRADLE_URL" -O "$TEMP_DIR/gradle.zip"
    else
        echo "ERROR: Neither curl nor wget found."
        exit 1
    fi
    
    unzip -q "$TEMP_DIR/gradle.zip" -d "$TEMP_DIR"
    "$TEMP_DIR/gradle-8.2/bin/gradle" wrapper --gradle-version 8.2 --project-dir "$APP_HOME"
    rm -rf "$TEMP_DIR"
    
    if [ ! -f "$CLASSPATH" ]; then
        echo "ERROR: Failed to create gradle-wrapper.jar"
        exit 1
    fi
fi

exec "$JAVACMD" \
    $JAVA_OPTS \
    $GRADLE_OPTS \
    "-Dorg.gradle.appname=$(basename "$0")" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
